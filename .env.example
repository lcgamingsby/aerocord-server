# ============================================================
# AeroCord Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git!
# ============================================================

# Server Port (Railway sets this automatically)
PORT=4000

# JWT Secret Key — use a strong random string (min 32 chars)
JWT_SECRET=GANTI_INI_DENGAN_STRING_ACAK_YANG_KUAT_MINIMAL_32_KARAKTER

# Encryption Master Key — must be exactly 64 hex chars (32 bytes)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC Key — used for database integrity seals
HMAC_SECRET_KEY=GANTI_DENGAN_HMAC_SECRET_YANG_KUAT

# ============================================================
# Supabase Configuration
# Get these from: Supabase Dashboard → Project Settings → API
# ============================================================
SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXX.XXXX
SUPABASE_STORAGE_BUCKET=aerocord-uploads

# ============================================================
# CORS: Frontend URL (Vercel deployment URL)
# ============================================================
CLIENT_URL=https://aerocord.vercel.app
